# Synthezer Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server Configuration
SYNTHEZER_PORT=8090          # Port for the Express server (default: 8090)
SYNTHEZER_HOST=0.0.0.0       # Bind address (default: 0.0.0.0)
SYNTHEZER_DB_PATH=            # Custom database path (default: ~/.Synthezer/synthezer.db)

# No API keys needed — Synthezer is local-first.
# AI gateway credentials are entered in the app UI, not stored in env vars.
